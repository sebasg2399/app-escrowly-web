# API base URL — empty means same-origin (Vite dev proxy handles it)
VITE_API_URL=

# Stripe publishable key (TEST MODE only).
# Used in later slices by the funding flow to load Stripe.js with
# `loadStripe(import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY)`. The value below is
# a placeholder — replace with the project's test publishable key from the
# Stripe dashboard (Settings → API keys → Publishable key).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
