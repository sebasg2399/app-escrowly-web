  "cards": [
    { "dot": "cyan", "title": "Two-token strategy", "items": ["Access token is a short-lived JWT kept in JS memory (not localStorage)", "Refresh token is opaque, hashed at rest, httpOnly + sameSite=strict + path=/auth"] },
    { "dot": "emerald", "title": "Silent refresh", "items": ["On 401, the API client calls POST /auth/refresh once, retries the original request", "Both tokens are rotated on every refresh — replay of the old refresh hash is rejected"] },
    { "dot": "orange", "title": "Server-side revocation", "items": ["sessions.revoked_at is checked on every refresh", "Logout = UPDATE sessions SET revoked_at=now() + clear cookie", "No JWT blacklist needed; the JWT only proves who, the session proves still-valid"] }
